{
  "name": "ctw-geo",
  "version": "0.1.0",
  "description": "Country, state and city data as a typed ESM package. Countries load eagerly; states and cities load lazily, one code-split chunk per country.",
  "keywords": [
    "countries",
    "states",
    "cities",
    "iso3166",
    "geo",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thechaudharysab/ctw-geo.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "homepage": "https://github.com/thechaudharysab/ctw-geo#readme",
  "bugs": {
    "url": "https://github.com/thechaudharysab/ctw-geo/issues"
  },
  "author": "thechaudharysab"
}
